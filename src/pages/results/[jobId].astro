---
import Layout from '../../layouts/Layout.astro';

const { jobId } = Astro.params;
---

<Layout title="Your Results – GradeThemRight">
  <div style="text-align:center; padding: 4rem 0;">
    <div style="font-size:3rem; margin-bottom:1rem;">⏳</div>
    <h1 style="font-size:1.5rem; color:#fff; margin-bottom:0.75rem;">Grading in progress…</h1>
    <p style="color:#64748b; margin-bottom:2rem;">Job ID: <code style="color:#818cf8">{jobId}</code></p>
    <p style="color:#475569; font-size:0.875rem;">AI grading coming in Step 3. Check back soon.</p>
    <a href="/grade" style="display:inline-block; margin-top:2rem; color:#818cf8; font-size:0.875rem;">← Grade another assignment</a>
  </div>
</Layout>
