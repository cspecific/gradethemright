---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-white mb-4">
      Get your assignment graded <span class="text-indigo-400">before you submit</span>
    </h1>
    <p class="text-gray-400 text-lg max-w-xl mx-auto">
      Upload your brief, your work, pick an AI — get structured feedback and an estimated grade in seconds.
    </p>
  </div>

  <div class="bg-white/5 border border-white/10 rounded-2xl p-8 text-center text-gray-500">
    Upload flow coming in Step 2 →
  </div>
</Layout>
